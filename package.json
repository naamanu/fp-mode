{
  "name": "fp-mode",
  "version": "0.1.0",
  "description": "A CLI online judge for functional programming — solve FP challenges in Haskell and OCaml",
  "type": "module",
  "bin": {
    "fp-mode": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["functional-programming", "haskell", "ocaml", "cli", "online-judge"],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dockerode": "^4.0.4",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "marked": "^15.0.7",
    "marked-terminal": "^7.3.0",
    "react": "^18.3.1",
    "simple-git": "^3.27.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.34",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
